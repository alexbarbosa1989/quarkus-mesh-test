# Required for the generic Java S2I builder (ubi8/openjdk-* or ubi9/openjdk-*)
# to correctly assemble a Quarkus fast-jar build. Without this, the default
# assemble script looks for a single jar in target/ and won't find a runnable
# entry point, since Quarkus fast-jar splits the app across lib/, app/,
# quarkus/ and quarkus-run.jar.
#
# Source: https://quarkus.io/guides/deploying-to-openshift-s2i-howto
MAVEN_S2I_ARTIFACT_DIRS=target/quarkus-app
S2I_SOURCE_DEPLOYMENTS_FILTER=app lib quarkus quarkus-run.jar
JAVA_OPTIONS=-Dquarkus.http.host=0.0.0.0
AB_JOLOKIA_OFF=true
JAVA_APP_JAR=/deployments/quarkus-run.jar
